# Embedding Service Configuration
EMBEDDING_BASE_URL=http://golem:4000/v1
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_API_KEY=<MyAPIKey>

# Retry Logic Configuration
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_BASE=2.0

# LLM Service Configuration (required for querying; ingestion does not use it)
LLM_BASE_URL=http://golem:4000/v1
LLM_MODEL=Gemma-4-26B-A4B
LLM_API_KEY=<MyAPIKey>
# How much the model reasons before answering: low (default), medium or high.
# Higher is better at tool use and step-by-step answers, but slower.
LLM_REASONING_EFFORT=medium

# Minimum similarity for BOTH the first retrieval of each question and the agent's
# search_documents tool (default 0.5). If the first retrieval finds nothing above it,
# the question ends with "No relevant documents found" and no LLM call is made.
# Relevant chunks score about 0.55-0.8, off-topic questions about 0.4 (see flaws.md).
SEARCH_MIN_SIMILARITY=0.5

# Chunking Configuration (characters, including each chunk's "Section: ..." line).
# Changing these needs a re-ingest with ENABLE_CHANGE_DETECTION=false, because
# change detection skips PDFs whose file hash has not changed.
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Table Extraction Configuration
ENABLE_TABLE_EXTRACTION=true

# Change Detection Configuration
ENABLE_CHANGE_DETECTION=true
CHANGE_DETECTION_LOG_LEVEL=critical

# Progress Tracking Configuration
SHOW_PROGRESS_BAR=true

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=vector_ingestion_collection

# Document Processing Configuration
DOCUMENT_INPUT_DIR=./documents